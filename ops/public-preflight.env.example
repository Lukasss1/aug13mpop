# Milk Pop local public-launch preflight — PUBLIC VALUES AND ATTESTATIONS ONLY.
# Copy this file to `.env.production.local`, fill the values, and never commit
# the resulting local file. Do not place private signing keys, service-role
# keys, Turnstile secrets, Resend keys, or any other server secret here.

# Public Supabase browser key for the project pinned in
# ops/milkpop-trust-policy.json. The URL is derived from that project ref.
VITE_SUPABASE_ANON_KEY=

# Public CAPTCHA site key. Keep both values false/blank only when Turnstile is
# deliberately disabled on the commissioned public-form function.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SERVER_ENABLED=false
TURNSTILE_SECRET_SET=false

# Set these to true only after the protected backend workflow has configured
# the exact production origin for the relevant Edge Function groups.
FORM_ALLOWED_ORIGINS_SET=true
CV_ALLOWED_ORIGINS_SET=true
EMAIL_ALLOWED_ORIGINS_SET=true

# Records that the owner notification recipient has been entered in Launch
# Facts. This is an operational attestation, not an e-mail address or secret.
NOTIFICATION_RECIPIENT_SET=true

# Safe opening defaults. Enable optional media/CV features only after their
# separate live gates pass.
VITE_MEDIA_V2=false
MEDIA_BACKEND_READY=false
VITE_CAREERS_CV_UPLOAD=false
CAREERS_CV_E2E_PASSED=false
CV_SCANNER_ATTESTED=false
MEDIA_CLEANUP_ENABLED=false
RETENTION_INVARIANT_TESTS_PASSED=false
VITE_LEGACY_IMPORT=false
VITE_ALLOW_BACKENDLESS=false

# Optional verified customer fallback address; leave blank otherwise.
VITE_CONFIRMED_CONTACT_EMAIL=
