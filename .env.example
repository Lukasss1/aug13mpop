# ---------------------------------------------------------------------------
# MILK POP — environment template (OPT-01 / OPT-01.1 contract).
# Copy to `.env` and fill in locally. NEVER commit `.env` (see .gitignore),
# NEVER paste real values here, and NEVER put a service-role key or any
# server SECRET in a VITE_ variable — VITE_* is embedded in the public JS
# bundle. Only the Supabase ANON key (public by design, constrained by Row
# Level Security) belongs in a VITE_ variable.
#
# Two kinds of variable appear below:
#   • VITE_*          → frontend build variables (compiled into the bundle).
#   • bare names      → build/deploy-time ATTESTATIONS the validator reads
#                       (scripts/validate-deployment-env.mjs). They are NOT
#                       secrets and NOT the server values themselves; they
#                       record "the paired server side is really configured".
# Real server secrets (TURNSTILE_SECRET, RESEND_API_KEY, SUPABASE_SERVICE_
# ROLE_KEY, MEDIA_CLEANUP_ENABLED, SITE_URL) live ONLY as Supabase Edge
# Function secrets / host env — never in this file.
# ---------------------------------------------------------------------------

# --- Deployment mode --------------------------------------------------------
# Arms the build-time validator. `production` makes every rule below a HARD
# failure; `development`/`preview` keep them advisory. On Netlify this is set
# automatically per context in netlify.toml (and the validator also reads
# Netlify's CONTEXT as a fallback), so you only set it by hand for local
# production-parity checks.
VITE_DEPLOYMENT_MODE=development

# --- Supabase (PAIR — set BOTH or, only if truly backend-less, NEITHER) ------
# In production the validator requires the pair; exactly one set is an error.
# OPT-02-C1.2: this same pair is now the SINGLE SOURCE OF TRUTH for the static
# SEO build. scripts/prerender-seo.ts reads the public rows with the ANON key
# (the same RLS view an anonymous visitor sees) and FAILS THE PRODUCTION BUILD
# if they are missing or unreadable — bundled seed defaults are never a
# production fallback. So a production Netlify build MUST have these set.
# T13.3.30 retains the existing legacy JWT-shaped anon-key contract. Use the
# project's Legacy API Keys -> anon value here, not an sb_publishable_* key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- SEO build (OPT-02-C1.2) — optional overrides ---------------------------
# The SEO generator reads VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY by default.
# These build-only aliases let a CI/build environment point the SEO read at a
# different anon endpoint WITHOUT changing the app's own pair. Anon key only —
# never a service-role key.
#   SEO_SUPABASE_URL=
#   SEO_SUPABASE_ANON_KEY=
# SITE_URL overrides the canonical origin baked into pages/sitemap/JSON-LD
# (default https://milkpop.uk). Set per host, not a secret.
#   SITE_URL=https://milkpop.uk
# CI/testing ONLY: point the loader at a JSON fixture that simulates PostgREST,
# so the production SEO path is exercised without a real project. Never set in a
# real deploy. (scripts/seo-source.test.ts + scripts/seo-prerender.test.ts.)
#   SEO_CONTENT_FIXTURE=scripts/fixtures/seo-content.fixture.json

# --- Cloudflare Turnstile (WP-02) — PAIRED -----------------------------------
# VITE_TURNSTILE_SITE_KEY renders the widget (public). The matching SECRET is
# the Edge Function secret TURNSTILE_SECRET (set with `supabase secrets set`)
# — it must NEVER use a VITE_ prefix. TURNSTILE_SERVER_ENABLED below is only a
# build/deploy ATTESTATION that the secret is configured server-side; it is
# NOT the secret. Site key without server = tokens no one verifies; server
# without site key = every public form rejected. Set the site key and the
# attestation together, or leave both empty/false.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SERVER_ENABLED=false

# --- WP-04R media pipeline — default SAFE (off) ------------------------------
# VITE_MEDIA_V2 turns on the optimised image pipeline in the app. It may only
# go on once MEDIA_BACKEND_READY=true attests the media Edge Functions are
# deployed and their live gate passed. Enabling MEDIA_V2 never enables cleanup.
VITE_MEDIA_V2=false
MEDIA_BACKEND_READY=false

# --- Careers CV upload — default OFF -----------------------------------------
# VITE_CAREERS_CV_UPLOAD shows the CV field on the careers form. Default OFF;
# the application form works end-to-end without an attachment. It may only be
# switched on once CAREERS_CV_E2E_PASSED=true attests the live Careers+CV
# staging E2E gate passed.
VITE_CAREERS_CV_UPLOAD=false
CAREERS_CV_E2E_PASSED=false

# --- Legacy data import — default OFF (C1.3) ---------------------------------
# VITE_LEGACY_IMPORT enables the one-time browser→cloud migration utility. It is
# a MIGRATION tool, not a continuing feature: even when true it is only shown,
# and only to an OWNER, when legacy localStorage data is actually detected on the
# device. Leave OFF on a clean install; set true only while migrating, then unset.
VITE_LEGACY_IMPORT=false

# --- Local development fixtures — default OFF -------------------------------
# Optional convenience for a backendless LOCAL development session. The code
# additionally requires import.meta.env.DEV, so this branch cannot activate in
# a production build even if the variable is copied accidentally.
VITE_DEV_SEED_CONTENT=false

# --- Fallback contact address — default BLANK (C1.3) -------------------------
# VITE_CONFIRMED_CONTACT_EMAIL is a verified, monitored inbox shown to a customer
# ONLY after a genuine contact-form submission failure. Blank by default so the
# site never invents an inbox; when set in production the env validator (R9)
# requires a syntactically valid single address. Do NOT use the owner-editable
# siteSettings.email here — that is configuration, not a verified contact.
VITE_CONFIRMED_CONTACT_EMAIL=

# --- Backend-less production override — default OFF (forbidden) ---------------
# A production build with NO Supabase pair is always refused. This flag exists
# only for explicit development/preview work and is forbidden in production. Leave false.
VITE_ALLOW_BACKENDLESS=false

# ---------------------------------------------------------------------------
# NOT set in the browser bundle (Supabase Edge Function secrets / protected host env):
#   TURNSTILE_SECRET               enables real CAPTCHA verification
#   RESEND_API_KEY (+ EMAIL_FROM)  transactional e-mail
#   SITE_URL                       non-secret canonical origin; set separately in the protected
#                                  build environment and as an Edge Function configuration value
#   SUPABASE_SERVICE_ROLE_KEY      platform-injected into functions
#   Static SEO refresh has NO hosting deploy-hook secret in T13.3.30.
#   request-seo-rebuild records a protected-release-pending handoff; only the
#   signed GitHub release workflow is allowed to publish the static SEO snapshot.
#   CV_ALLOWED_ORIGINS / FORM_ALLOWED_ORIGINS   optional CORS pinning
#   MEDIA_CLEANUP_ENABLED          LEAVE UNSET — cleanup stays inert; setting it
#                                  true fails deployment readiness (OPT-01.1 §6)
# ---------------------------------------------------------------------------

# Build-injected release identity shown in Operational Health
VITE_RELEASE_IDENTITY=r4.10.15-t13.3.30-final-production-closure
